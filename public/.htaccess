# Skyline website — Apache / cPanel config (Vite copies this into dist/).
# /api/* goes to the PHP front controller on this same host; everything else
# that is not a real file goes to index.html, so /admin works on refresh.

Options -Indexes
RewriteEngine On
RewriteBase /

# Apache strips the Authorization header for CGI/FPM PHP — re-export it
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# prefer the bare domain (keeps one origin for sign-in and CORS)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# API → PHP (must come before the SPA fallback)
RewriteRule ^api(/.*)?$ api/index.php [L]

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteRule ^ index.html [L]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"

  # hashed build assets never change; index.html must always be fresh
  <FilesMatch "\.(js|css|woff2|webp|jpg|png|glb)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
